# Prettier already skips everything in .gitignore, so this file is only for
# things that are tracked but must not be reformatted.

# Written by pnpm, in pnpm's own style. Formatting it would put `format:check`
# in a fight it cannot win: prettier rewrites the file, the next `pnpm install`
# rewrites it back, and CI fails on a lockfile nobody edited.
pnpm-lock.yaml

# Generated icon set for the desktop bundle (binary, and derived from
# packages/desktop/icons/app-icon.png).
packages/desktop/src-tauri/icons/

# A verbatim copy of ~/.config/nvim, deployed to the box (see deploy/README.md).
# Reformatting it would make the copy differ from the original for reasons that
# have nothing to do with the config, so every future `rsync` would show
# spurious changes and the two would drift apart in the diff rather than in
# fact. lazy-lock.json is written by lazy.nvim, in lazy.nvim's style.
deploy/nvim-config/
