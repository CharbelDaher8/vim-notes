# Copy to deploy/.env and edit. Read by both docker compose and bootstrap.sh,
# so the two can never disagree about where the repositories live.

# --- where the notes live ----------------------------------------------------
#
# Absolute paths on the host. Both are bind-mounted into the container at the
# same path they have here, because notes/.git/config records `origin` as an
# absolute path and that file is read from both sides.
#
# Neither should be inside this repository -- they are your notes, not source.
NOTES_DIR=/srv/vim-notes/notes
HUB_DIR=/srv/vim-notes/notes.git

# --- who the container runs as -----------------------------------------------
#
# Must be you: the post-receive hook runs on the host as your user and touches
# the same working copy. Fill in with:  echo "DOCKER_USER=$(id -u):$(id -g)"
DOCKER_USER=1000:1000

# --- who can reach it --------------------------------------------------------
#
# The host's tailnet address -- `tailscale ip -4` prints it. This is the whole
# access control story (DECISIONS §11): the listener exists only on the
# WireGuard interface, so there is nothing on the public internet to attack.
#
# 127.0.0.1 is the fail-closed default. Setting 0.0.0.0 here publishes a shell.
BIND_ADDR=100.64.0.1
BIND_PORT=8080

# --- git identity for auto-commits -------------------------------------------
GIT_AUTHOR_NAME=vim-notes
GIT_AUTHOR_EMAIL=vim-notes@localhost

# --- your editor config ------------------------------------------------------
#
# Directory containing init.lua, mounted read-only as ~/.config/nvim inside the
# container. Point it at your real dotfiles checkout if you have one.
NVIM_CONFIG_DIR=./nvim-config

# --- how file changes are noticed --------------------------------------------
#
# The web client reloads a note when nvim writes it, which depends on the
# server actually seeing the write. Native recursive watching is accurate on
# Linux with a normal filesystem, so this stays off by default -- polling a
# large tree burns CPU continuously.
#
# Set it to true if NOTES_DIR is a bind mount from a macOS or Windows host
# (Docker Desktop), or lives on a network filesystem. Those drop events, and
# the failure is silent: the watcher looks healthy and simply never fires, so
# the browser stops noticing anything nvim does.
WATCH_POLLING=false
WATCH_POLL_INTERVAL_MS=100
