# Copy to deploy/.env and edit. Read by both docker compose and bootstrap.sh,
# so the two can never disagree about where the notes live.

# --- where the notes live ----------------------------------------------------
#
# Absolute path on the host, bind-mounted into the container at the same path.
# Should not be inside this repository -- they are your notes, not source.
NOTES_DIR=/srv/vim-notes/notes

# The private GitHub repository the notes are pushed to (DECISIONS §2).
#
# SSH rather than HTTPS: the credential is then a deploy key scoped to this one
# repository, and unlike a token it never ends up written into .git/config.
GIT_REMOTE_URL=git@github.com:you/notes.git

# --- the deploy key ----------------------------------------------------------
#
# A key with *write* access to that repository, mounted read-only into the
# container. Generate one and add the public half under
# Settings -> Deploy keys -> Add deploy key, with "Allow write access" ticked:
#
#     ssh-keygen -t ed25519 -N '' -C vim-notes -f /srv/vim-notes/deploy-key
#     chmod 600 /srv/vim-notes/deploy-key
#     cat /srv/vim-notes/deploy-key.pub
#
# ssh refuses a key that others can read, so the chmod is not optional.
GIT_SSH_KEY_PATH=/srv/vim-notes/deploy-key

# --- syncing -----------------------------------------------------------------
#
# How often the server pulls and pushes, in milliseconds.
#
# Polling exists because the server is tailnet-only and a GitHub webhook cannot
# reach it, so a laptop push takes up to this long to appear. Minimum 5000;
# 0 disables syncing entirely and makes this box a local-only island.
SYNC_INTERVAL_MS=60000

# --- who the container runs as -----------------------------------------------
#
# Must own NOTES_DIR and be able to read the deploy key. Fill in with:
#     echo "DOCKER_USER=$(id -u):$(id -g)"
DOCKER_USER=1000:1000

# --- who can reach it --------------------------------------------------------
#
# The host's tailnet address -- `tailscale ip -4` prints it. This is the whole
# access control story (DECISIONS §11): the listener exists only on the
# WireGuard interface, so there is nothing on the public internet to attack.
#
# 127.0.0.1 is the fail-closed default. Setting 0.0.0.0 here publishes a shell.
BIND_ADDR=100.64.0.1
BIND_PORT=8080

# --- git identity for auto-commits -------------------------------------------
GIT_AUTHOR_NAME=vim-notes
GIT_AUTHOR_EMAIL=vim-notes@localhost

# --- filesystem watching -----------------------------------------------------
#
# Turn polling on when NOTES_DIR is a bind mount from a macOS or Windows host,
# or any network filesystem: native recursive watching drops events on those and
# fails silently, so the browser simply stops seeing what nvim writes.
WATCH_POLLING=false
WATCH_POLL_INTERVAL_MS=100

# --- your editor config ------------------------------------------------------
#
# Directory containing init.lua, mounted read-only as ~/.config/nvim inside the
# container. Point it at your real dotfiles checkout if you have one.
NVIM_CONFIG_DIR=./nvim-config
