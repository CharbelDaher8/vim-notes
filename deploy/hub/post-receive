#!/bin/sh
#
# Hub post-receive hook -- fast-forward the server working copy after a push.
#
# This is the moving part of DECISIONS.md §2. The hub is bare precisely because
# you cannot push into a repository whose branch is checked out, and
# `receive.denyCurrentBranch=updateInstead` only works on a perfectly clean
# working tree -- which this one will not be two seconds after nvim writes a
# file. So the push lands in the bare hub, and this hook tries to bring the
# working copy along afterwards.
#
# The governing rule is that this hook is allowed to fail. It runs unattended,
# with no way to ask anyone anything, against a directory that a human may be
# typing into right now. So it only ever does the one operation that cannot
# lose work -- a fast-forward -- and when that is not possible it does nothing
# at all and says so. The server's own sync() already handles rebasing,
# conflicts and pushing, with a typed outcome for each; anything cleverer here
# would be a second, worse implementation of that, racing the first.
#
# Specifically it will NOT: stash (pop can conflict, unattended), reset --hard
# (discards the working tree), or rebase (leaves conflict markers on disk that
# the auto-committer would then commit as the note's content).
#
# It also never fails the push. By the time post-receive runs the refs are
# already updated, so a non-zero exit here would report a failure for something
# that actually succeeded. Every path prints what happened and exits 0.

set -eu

# Resolved before the unset below, while GIT_DIR still points here.
HUB_DIR="$(git rev-parse --absolute-git-dir 2>/dev/null || pwd)"

# Branch that carries the notes. Everything else -- tags, scratch branches --
# is stored in the hub but never checked out here.
BRANCH="${NOTES_BRANCH:-main}"

# Where the server working copy lives. A push arrives over ssh, which does not
# carry the pusher's environment, so the real answer comes from the hub's own
# config -- bootstrap.sh writes it there. The environment variable is for test
# harnesses, and the literal is a last resort that matches the compose layout.
WORK_TREE="${NOTES_WORK_TREE:-}"
if [ -z "$WORK_TREE" ]; then
	WORK_TREE="$(git --git-dir="$HUB_DIR" config --get notes.worktree 2>/dev/null || true)"
fi
WORK_TREE="${WORK_TREE:-/srv/vim-notes/notes}"

# git invokes hooks with GIT_DIR pointing at the hub, plus a quarantine object
# directory during receive. Left in place, every command below would silently
# operate on the hub no matter what `-C` says -- this is the single most common
# bug in hooks of this kind, and it fails in a way that looks like the hook
# simply did nothing.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_QUARANTINE_PATH
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

# Hook output reaches the pusher prefixed with "remote:", which is the only
# channel this thing has to explain itself. Worth using.
say() {
	echo "vim-notes hub: $*" >&2
}

# stdin is one "<old> <new> <ref>" line per updated ref.
updated=0
while read -r _old new ref; do
	[ "$ref" = "refs/heads/$BRANCH" ] || continue

	# An all-zero new value means the branch was deleted. Nothing to check out,
	# and certainly nothing to delete from the working copy on its behalf.
	case "$new" in
	*[!0]*) updated=1 ;;
	esac
done

[ "$updated" -eq 1 ] || exit 0

if [ ! -d "$WORK_TREE/.git" ]; then
	say "no working copy at $WORK_TREE -- push is stored in the hub only"
	exit 0
fi

# Uncommitted changes mean a human or the auto-committer is mid-write. Touching
# the tree now is how you lose the paragraph someone was typing.
if ! git -C "$WORK_TREE" diff --quiet 2>/dev/null ||
	! git -C "$WORK_TREE" diff --cached --quiet 2>/dev/null; then
	say "working copy has uncommitted changes -- left untouched"
	say "the server commits and syncs on its own; this push will land then"
	exit 0
fi

if ! git -C "$WORK_TREE" fetch --quiet origin 2>/dev/null; then
	say "could not fetch into $WORK_TREE -- left untouched"
	exit 0
fi

# --ff-only is the entire safety argument. If the working copy has commits the
# hub does not, this refuses rather than merging or rewriting, and the server's
# next sync() rebases them properly and pushes them back.
#
# It also refuses when an untracked file would be overwritten by the incoming
# commits, which is the other way this could have quietly destroyed something.
if git -C "$WORK_TREE" merge --quiet --ff-only "origin/$BRANCH" 2>/dev/null; then
	say "working copy fast-forwarded to $(git -C "$WORK_TREE" rev-parse --short HEAD)"
else
	say "working copy could not fast-forward -- left untouched"
	say "it has local commits or conflicting untracked files; server sync will resolve it"
fi

exit 0
